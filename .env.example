# Firebase web app config (public client values — NOT service account secrets)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Multi-tenant default business for this deployment
VITE_DEFAULT_BUSINESS_ID=cakes-by-kee

# Local dev: /
# This GitHub repo Pages URL: https://visify-apps.github.io/cakes-by-kee/
VITE_BASE_PATH=/cakes-by-kee/

# Keep false to stay on free tier (no Firebase Storage). Reference photos go via WhatsApp.
VITE_ENABLE_FIREBASE_STORAGE=false
