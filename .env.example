# Firebase web app config (public client values — NOT service account secrets)
# The GCP/Firebase PROJECT can stay named cakes-by-kee. That is not the shop document.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# This shop only: Firestore path businesses/{id}/...
VITE_DEFAULT_BUSINESS_ID=cakes-by-kee

# GitHub Pages URL prefix (repo name). Independent of the shop document id.
# Local: /
VITE_BASE_PATH=/cakes-by-kee/

# Keep false to stay on free tier (no Firebase Storage). Reference photos go via WhatsApp.
VITE_ENABLE_FIREBASE_STORAGE=false
