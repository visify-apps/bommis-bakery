# Firebase web app config (public client values — NOT service account secrets)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Multi-tenant default business for this deployment
VITE_DEFAULT_BUSINESS_ID=cakes-by-kee

# GitHub Pages project site example: /CakeStoreFront/
# Custom domain or user/org site: /
VITE_BASE_PATH=/

# Keep false to stay on free tier (no Firebase Storage). Reference photos go via WhatsApp.
# Set true only if you enable Storage in Firebase Console (often requires Blaze).
VITE_ENABLE_FIREBASE_STORAGE=false
